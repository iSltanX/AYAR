{
  "name": "ayar-fx-ext",
  "version": "1.0.0",
  "private": true,
  "description": "FX-EXT: إضافة Chromium (Manifest V3) لعدّ الكلمات — مشروع اختبار لعِيَار، لا يُنشر",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc --noEmit && vite build",
