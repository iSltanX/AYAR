{
  "$comment": "الحالات المعلنة لـ FX-WEB-DESIGN بصيغة مرجع «الحالات» في ملف المعايير (DEV-7: ProbeStates في packages/protocol). لكل حالة مسارها ومحاكاة شبكتها وتوقعاتها؛ والحالة «حساسة» لا تُلتقط لها صورة. التحميل بتأخير ثانيتين والخطأ برمز 500 (AT-19).",
  "states": [
    {
      "id": "default",
      "description": "قائمة العناصر محمّلة",
      "path": "/",
      "mock": [{ "url": "/api/items", "status": 200, "bodyFile": "mocks/items.json" }],
      "expect": [{ "visible": "#app[data-state='default']" }, { "text": { "ar": "هاتف ذكي", "en": "Smartphone" }, "within": "#app" }]
    },
    {
      "id": "loading",
      "description": "تحميل بطيء: تظهر الهياكل ورسالة التحميل",
      "path": "/",
      "mock": [{ "url": "/api/items", "status": 200, "delayMs": 2000, "bodyFile": "mocks/items.json" }],
      "expect": [{ "visible": "#app[data-state='loading']" }, { "text": { "ar": "جارٍ تحميل العناصر…", "en": "Loading items…" }, "within": "#app" }]
    },
    {
      "id": "error",
      "description": "فشل الخادم: تظهر رسالة الخطأ المتوقعة",
      "path": "/",
      "mock": [{ "url": "/api/items", "status": 500 }],
      "expect": [{ "visible": "#app[data-state='error'] [role='alert']" }, { "text": { "ar": "تعذّر تحميل العناصر", "en": "Could not load items" }, "within": "#app[data-state='error'] [role='alert']" }]
    },
    {
      "id": "empty",
      "description": "قائمة فارغة",
      "path": "/",
      "mock": [{ "url": "/api/items", "status": 200, "body": [] }],
      "expect": [{ "visible": "#app[data-state='empty']" }, { "text": { "ar": "لا عناصر لعرضها", "en": "No items to show" }, "within": "#app" }]
    },
    {
      "id": "account",
      "description": "لوحة الحساب تعرض رصيدًا وهميًّا",
      "path": "/?panel=account",
      "sensitive": true,
      "reason": "تعرض بيانات مالية (وهمية هنا)، فلا تُلتقط لها صورة ولا تدخل المقارنة البصرية، وتظهر في المعرض بسببها",
      "mock": [{ "url": "/api/items", "status": 200, "bodyFile": "mocks/items.json" }],
      "expect": [{ "visible": "section.account[data-sensitive='true']" }]
    }
  ]
}
