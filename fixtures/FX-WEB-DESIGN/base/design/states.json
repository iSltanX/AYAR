{
  "$comment": "الحالات المعلنة لـ FX-WEB-DESIGN: لكل حالة محاكاة شبكة وتوقع. الصيغة مؤقتة حتى تعتمدها DEV-6/DEV-7 في ملف المعايير.",
  "states": [
    {
      "id": "default",
      "description": "قائمة العناصر محمّلة",
      "url": "/",
      "mock": { "/api/items": { "status": 200, "body_file": "mocks/items.json" } },
      "expect": { "text": { "ar": "هاتف ذكي", "en": "Smartphone" }, "selector": "#app[data-state='default']" }
    },
    {
      "id": "loading",
      "description": "تحميل بطيء: تظهر الهياكل ورسالة التحميل",
      "url": "/",
      "mock": { "/api/items": { "status": 200, "delay_ms": 8000, "body_file": "mocks/items.json" } },
      "expect": { "text": { "ar": "جارٍ تحميل العناصر…", "en": "Loading items…" }, "selector": "#app[data-state='loading']" }
    },
    {
      "id": "error",
      "description": "فشل الخادم: تظهر رسالة الخطأ المتوقعة",
      "url": "/",
      "mock": { "/api/items": { "status": 500 } },
      "expect": { "text": { "ar": "تعذّر تحميل العناصر", "en": "Could not load items" }, "selector": "#app[data-state='error'] [role='alert']" }
    },
    {
      "id": "empty",
      "description": "قائمة فارغة",
      "url": "/",
      "mock": { "/api/items": { "status": 200, "body": [] } },
      "expect": { "text": { "ar": "لا عناصر لعرضها", "en": "No items to show" }, "selector": "#app[data-state='empty']" }
    },
    {
      "id": "account",
      "description": "لوحة الحساب تعرض رصيدًا وهميًّا",
      "url": "/?panel=account",
      "sensitive": true,
      "sensitive_reason": "تعرض بيانات مالية (وهمية هنا)، فلا تُلتقط لها صورة ولا تدخل المقارنة البصرية، وتظهر في المعرض بسببها",
      "mock": { "/api/items": { "status": 200, "body_file": "mocks/items.json" } },
      "expect": { "selector": "section.account[data-sensitive='true']" }
    }
  ]
}
