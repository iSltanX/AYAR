{
  "$description": "رموز التصميم بصيغة DTCG. قيمة $value للثيم الفاتح، وقيمة الثيم الداكن في $extensions.mode.dark. يولَّد منها styles/tokens.css بـ: node tools/build-tokens.mjs",
  "color": {
    "$type": "color",
    "bg": { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#12171d" } } },
    "surface": { "$value": "#f3f5f8", "$extensions": { "mode": { "dark": "#1b222b" } } },
    "text": { "$value": "#1b1f24", "$extensions": { "mode": { "dark": "#e8ecf1" } } },
    "text-muted": { "$value": "#596270", "$extensions": { "mode": { "dark": "#a3adba" } } },
    "primary": { "$value": "#0b5cd5", "$extensions": { "mode": { "dark": "#6ea8ff" } } },
    "on-primary": { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#0a1220" } } },
    "danger": { "$value": "#b3261e", "$extensions": { "mode": { "dark": "#ff8a80" } } },
    "border": { "$value": "#c4cad3", "$extensions": { "mode": { "dark": "#3a4552" } } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "body": { "$value": ["Cairo", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "28px" }
    }
  }
}
