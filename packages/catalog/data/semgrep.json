      "id": "ayar.js.eval-dynamic",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "ERROR",
      "message": "eval() runs a value that is not a constant: whatever reaches it runs as code.",
      "patterns": [
        {
          "pattern-either": [
            {
              "pattern": "eval($X)"
            },
            {
              "pattern": "window.eval($X)"
            },
            {
              "pattern": "globalThis.eval($X)"
            }
          ]
        },
        {
          "pattern-not": "eval(\"...\")"
        },
        {
          "pattern-not": "window.eval(\"...\")"
        },
        {
          "pattern-not": "globalThis.eval(\"...\")"
        }
      ],
      "metadata": {
        "ayar": {
          "category": "forbidden",
          "version": "1.0.0"
        },
        "cwe": "CWE-95"
      }
    },
