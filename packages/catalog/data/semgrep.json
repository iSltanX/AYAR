      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "HTML is written from a value that is not a constant (innerHTML, outerHTML, insertAdjacentHTML, document.write): check that it cannot carry markup from outside.",
      "patterns": [
        {
          "pattern-either": [
            {
              "pattern": "$EL.innerHTML = $X"
            },
            {
              "pattern": "$EL.innerHTML += $X"
